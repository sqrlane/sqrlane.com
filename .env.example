# Copy this file to .env and paste your key in. NEVER commit .env.
#   cp .env.example .env

# Which provider llm.py talks to: groq | gemini | ollama
LLM_PROVIDER=groq

# --- Groq (recommended default) - https://console.groq.com ---
GROQ_API_KEY=

# --- Google Gemini - https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Ollama (local, no key needed) - https://ollama.com ---
OLLAMA_HOST=http://localhost:11434

# Optional: override the model for whichever provider is selected.
# Leave blank to use the sensible default in src/config.py.
LLM_MODEL=
