# Copy this file to .env and paste your key in. NEVER commit .env.
#   cp .env.example .env

# Which provider llm.py talks to: groq | hf | gemini | ollama
LLM_PROVIDER=groq

# --- Groq (recommended default) - https://console.groq.com ---
GROQ_API_KEY=

# --- Hugging Face Inference Providers - https://huggingface.co/settings/tokens ---
# One token in front of several upstream backends (Groq, Together, Fireworks,
# Cerebras and others). Set LLM_PROVIDER=hf to use it.
#
# Worth knowing: this is the escape hatch for the rate limit that makes the last
# drafts of a cycle fall back to a template. A 429 on one backend is a routing
# choice here rather than a wall.
HF_TOKEN=

# Optional. Only set this to point at a different OpenAI-compatible gateway.
# HF_BASE_URL=https://router.huggingface.co/v1

# --- Google Gemini - https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Ollama (local, no key needed) - https://ollama.com ---
OLLAMA_HOST=http://localhost:11434

# Optional. Leave BLANK - this is the recommended setting.
#
# On Groq and Hugging Face the model is discovered at runtime: the app asks your
# key which models it can actually run and picks the best available one. That is
# deliberate, because providers retire and rename models, and a hard-coded name
# that has been retired fails with a 404 that looks exactly like a broken key.
#
# Set this only to pin one specific model. Even then it is not a hard pin: if
# the pinned model turns out to be unavailable, the app falls back to
# discovery rather than failing the run.
#
# On Hugging Face a model id is a hub repo path, and you can pin the upstream
# backend by suffixing it:
#   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct:groq
#
# See what your key offers:  python -m src.llm --models
LLM_MODEL=
