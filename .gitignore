# Secrets - NEVER commit
.env

# Runtime state
risk_state.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local caches
.cache/
data/cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Natural Earth source data for tools/build_rhine_map.py - fetched on demand,
# never committed (5.5 MB, and the map it produces is already inlined).
tools/.ne-cache/

# ML layer (ml/) - the full synthetic book is ~13 MB and byte-identical
# reproducible from its seed (python -m ml.synth --bookings 6000 --seed 7),
# so only the 50-record sample beside it is committed.
ml/data/tms_synthetic_bookings.json
.vercel
.env*

# The hero reel's footage. Deliberately not in the repository: the clips this
# was built against are iStock comps - watermarked previews, licensed for
# layout evaluation and not for publication - and committing them would put a
# Getty watermark across the hero of a public site. The page treats their
# absence as a supported state and renders without them; see
# static/video/README.md for what to drop in and the one property the
# footage has to have.
static/video/*.mp4

# Where the comps were downloaded to. Same reason.
stock video for landing page/
